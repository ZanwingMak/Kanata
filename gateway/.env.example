# 服务监听
PORT=9321
HOST=0.0.0.0

# 访问令牌（FR-GW-004）。公网部署必须修改，路径形式 http://host:9321/{TOKEN}/api/v2/...
TOKEN=87654321

# 弹弹play 开放平台密钥（https://doc.dandanplay.com/open/ 申请）
# 未配置时以匿名方式请求，部分接口可能受限
DANDANPLAY_APP_ID=
DANDANPLAY_APP_SECRET=

# 自定义弹弹play兼容 API 池；Token 可留空或直接写入 baseUrl 路径
# strategy: fallback（顺序回退）/ race（最多3路竞速）/ aggregate（同集聚合）
CUSTOM_PROVIDER_STRATEGY=fallback
CUSTOM_PROVIDERS_JSON=[]
# 示例（请保持为单行）：[{"id":"home","name":"家庭服务","baseUrl":"http://nas:9321/mytoken","token":"","enabled":true}]

# 缓存（FR-DMK-012：遵守弹弹play 2-24h 缓存建议）
DANMAKU_CACHE_TTL_SEC=43200
# 正常 TTL 过期后，上游故障时最多继续使用 7 天旧缓存
DANMAKU_STALE_TTL_SEC=604800
SEARCH_CACHE_TTL_SEC=21600
CACHE_MAX_ENTRIES=500
CACHE_MAX_MB=2048
# 开启后网关重启仍可恢复弹幕旧缓存；目录中不保存任何账号凭证
CACHE_PERSIST=true
CACHE_DIR=./data/cache

# 出网（FR-GW-009）
REQUEST_TIMEOUT_MS=8000
PROXY_URL=

# 允许访问网关的 Web 前端来源，逗号分隔；原生 App 和 curl 不携带 Origin，不受影响
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# 日志级别 fatal|error|warn|info|debug|trace
LOG_LEVEL=info
