# 服务监听
PORT=9321
HOST=0.0.0.0

# 访问令牌（FR-GW-004）。公网部署必须修改，路径形式 http://host:9321/{TOKEN}/api/v2/...
TOKEN=87654321

# 弹弹play 开放平台密钥（https://doc.dandanplay.com/open/ 申请）
# 未配置时以匿名方式请求，部分接口可能受限
DANDANPLAY_APP_ID=
DANDANPLAY_APP_SECRET=

# 缓存（FR-DMK-012：遵守弹弹play 2-24h 缓存建议）
DANMAKU_CACHE_TTL_SEC=43200
SEARCH_CACHE_TTL_SEC=21600
CACHE_MAX_ENTRIES=500

# 出网（FR-GW-009）
REQUEST_TIMEOUT_MS=8000
PROXY_URL=

# 日志级别 fatal|error|warn|info|debug|trace
LOG_LEVEL=info
